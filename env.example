DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
INTEGRATION_API_KEY=replace-with-a-long-random-secret

# URL completa del endpoint PHP del sistema original (sin el parámetro id).
CONTRATOS_API_URL=


# Carpeta persistente privada de documentos; valor por defecto: storage/pagos.
PAGOS_STORAGE_DIR=

# Edicion de cotizaciones suspendida; no afecta registros iniciales ni abonos.
PAGOS_EDITAR_COTIZACIONES=false
